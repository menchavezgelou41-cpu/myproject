

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gelou Sacul Menchavez | BSIT Student</title>

    <style>
        /* =========================
           RESET
        ========================= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #070b18;
            color: #f8fafc;
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }

        .container {
            width: 90%;
            max-width: 1120px;
            margin: auto;
        }

        /* =========================
           NAVIGATION
        ========================= */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;

            background: rgba(7, 11, 24, 0.88);
            backdrop-filter: blur(15px);

            border-bottom: 1px solid rgba(34, 211, 238, 0.12);
        }

        nav {
            min-height: 75px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .logo span {
            color: #22d3ee;
        }

        .nav-links {
            display: flex;
            gap: 28px;
        }

        .nav-links a {
            position: relative;

            color: #cbd5e1;
            font-size: 0.85rem;
            font-weight: 600;

            transition: 0.3s ease;
        }

        .nav-links a::after {
            content: "";

            position: absolute;
            left: 0;
            bottom: -8px;

            width: 0;
            height: 2px;

            background: #22d3ee;

            transition: 0.3s ease;
        }

        .nav-links a:hover {
            color: #22d3ee;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* =========================
           HERO
        ========================= */
        #home {
            min-height: 100vh;

            display: flex;
            align-items: center;

            padding-top: 80px;

            position: relative;
            overflow: hidden;

            background:
                radial-gradient(
                    circle at 15% 30%,
                    rgba(34, 211, 238, 0.12),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 85% 70%,
                    rgba(139, 92, 246, 0.14),
                    transparent 30%
                ),
                #070b18;
        }

        #home::before {
            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            border-radius: 50%;

            background: #22d3ee;

            filter: blur(120px);

            opacity: 0.07;

            top: 10%;
            left: -150px;
        }

        #home::after {
            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            border-radius: 50%;

            background: #8b5cf6;

            filter: blur(120px);

            opacity: 0.08;

            right: -150px;
            bottom: 5%;
        }

        .hero {
            display: grid;

            grid-template-columns: 1.3fr 0.7fr;

            gap: 70px;

            align-items: center;

            position: relative;
            z-index: 2;
        }

        .small-title {
            color: #22d3ee;

            font-size: 0.75rem;
            font-weight: 800;

            letter-spacing: 3px;

            margin-bottom: 18px;
        }

        .hero h1 {
            font-size: clamp(3rem, 7vw, 5.3rem);

            line-height: 1;

            letter-spacing: -4px;

            margin-bottom: 22px;
        }

        .hero h1 span {
            display: block;

            background: linear-gradient(
                100deg,
                #22d3ee,
                #a78bfa
            );

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;
        }

        .hero h2 {
            color: #c7d2fe;

            font-size: clamp(1rem, 2vw, 1.35rem);

            margin-bottom: 20px;
        }

        .hero-description {
            max-width: 680px;

            color: #94a3b8;

            font-size: 0.98rem;

            margin-bottom: 32px;
        }

        .buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-width: 145px;

            padding: 13px 23px;

            border-radius: 8px;

            font-size: 0.88rem;
            font-weight: 700;

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                background 0.3s ease;
        }

        .btn-primary {
            color: #03131b;

            background: linear-gradient(
                135deg,
                #22d3ee,
                #67e8f9
            );

            border: none;

            box-shadow:
                0 10px 30px rgba(34, 211, 238, 0.18);
        }

        .btn-primary:hover {
            transform: translateY(-4px);

            box-shadow:
                0 15px 35px rgba(34, 211, 238, 0.35);
        }

        .btn-secondary {
            color: #22d3ee;

            border: 1px solid rgba(34, 211, 238, 0.4);

            background: rgba(34, 211, 238, 0.04);
        }

        .btn-secondary:hover {
            transform: translateY(-4px);

            background: #22d3ee;

            color: #03131b;

            box-shadow:
                0 10px 30px rgba(34, 211, 238, 0.2);
        }

        /* =========================
           PROFILE CARD
        ========================= */
        .profile-card {
            position: relative;

            padding: 45px 30px;

            text-align: center;

            background:
                linear-gradient(
                    145deg,
                    rgba(18, 30, 58, 0.9),
                    rgba(10, 17, 35, 0.9)
                );

            border: 1px solid rgba(34, 211, 238, 0.18);

            border-radius: 24px;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.35);

            animation: floating 5s ease-in-out infinite;
        }

        .profile-card::before {
            content: "";

            position: absolute;

            inset: -1px;

            border-radius: 24px;

            background: linear-gradient(
                135deg,
                rgba(34, 211, 238, 0.25),
                transparent,
                rgba(139, 92, 246, 0.25)
            );

            z-index: -1;
        }

        .profile-circle {
            width: 145px;
            height: 145px;

            margin: 0 auto 25px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    rgba(34, 211, 238, 0.12),
                    rgba(139, 92, 246, 0.2)
                );

            border: 2px solid rgba(34, 211, 238, 0.45);

            box-shadow:
                0 0 35px rgba(34, 211, 238, 0.12),
                inset 0 0 30px rgba(139, 92, 246, 0.1);

            color: #67e8f9;

            font-size: 2.5rem;
            font-weight: 800;
        }

        .profile-card h3 {
            font-size: 1.35rem;
            margin-bottom: 5px;
        }

        .profile-card p {
            color: #94a3b8;
        }

        .status {
            display: inline-block;

            margin-top: 20px;

            padding: 7px 13px;

            border-radius: 50px;

            color: #6ee7b7;

            background: rgba(16, 185, 129, 0.08);

            border: 1px solid rgba(16, 185, 129, 0.2);

            font-size: 0.72rem;
        }

        /* =========================
           SECTIONS
        ========================= */
        section:not(#home) {
            padding: 110px 0;
        }

        section:nth-of-type(even) {
            background: #090f20;
        }

        .section-heading {
            max-width: 700px;
            margin-bottom: 55px;
        }

        .section-label {
            color: #22d3ee;

            font-size: 0.75rem;
            font-weight: 800;

            letter-spacing: 3px;
        }

        .section-heading h2 {
            font-size: clamp(2.3rem, 5vw, 3.3rem);

            line-height: 1.1;

            letter-spacing: -2px;

            margin: 10px 0 18px;
        }

        .section-heading h2 span {
            color: #22d3ee;
        }

        .section-heading p {
            color: #94a3b8;
            max-width: 650px;
        }

        /* =========================
           ABOUT
        ========================= */
        .about-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 22px;
        }

        .about-card {
            padding: 30px;

            background: #0d162b;

            border: 1px solid rgba(34, 211, 238, 0.13);

            border-radius: 15px;

            transition:
                transform 0.35s ease,
                border-color 0.35s ease,
                box-shadow 0.35s ease;
        }

        .about-card:hover {
            transform: translateY(-8px);

            border-color: rgba(34, 211, 238, 0.45);

            box-shadow:
                0 20px 45px rgba(0, 0, 0, 0.3),
                0 0 25px rgba(34, 211, 238, 0.06);
        }

        .about-number {
            color: #22d3ee;

            font-size: 0.8rem;
            font-weight: 800;

            margin-bottom: 28px;
        }

        .about-card h3 {
            font-size: 1.2rem;
            margin-bottom: 12px;
        }

        .about-card p {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        /* =========================
           SKILLS
        ========================= */
        .skills-grid {
            display: grid;

            grid-template-columns: repeat(4, 1fr);

            gap: 18px;
        }

        .skill-card {
            position: relative;

            padding: 28px;

            min-height: 330px;

            background: #0d162b;

            border: 1px solid rgba(139, 92, 246, 0.15);

            border-radius: 15px;

            transition:
                transform 0.35s ease,
                border-color 0.35s ease,
                box-shadow 0.35s ease;
        }

        .skill-card:hover {
            transform: translateY(-9px);

            border-color: rgba(139, 92, 246, 0.5);

            box-shadow:
                0 20px 40px rgba(0, 0, 0, 0.3),
                0 0 25px rgba(139, 92, 246, 0.08);
        }

        .skill-icon {
            width: 55px;
            height: 55px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 24px;

            color: #22d3ee;

            background: rgba(34, 211, 238, 0.08);

            border: 1px solid rgba(34, 211, 238, 0.2);

            border-radius: 12px;

            font-size: 0.9rem;
            font-weight: 800;
        }

        .skill-card h3 {
            font-size: 1.08rem;

            margin-bottom: 12px;
        }

        .skill-card p {
            color: #94a3b8;

            font-size: 0.83rem;

            min-height: 88px;
        }

        .skill-bar {
            width: 100%;
            height: 4px;

            margin: 18px 0 8px;

            background: #1e293b;

            border-radius: 10px;

            overflow: hidden;
        }

        .skill-bar span {
            display: block;

            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    #22d3ee,
                    #8b5cf6
                );

            border-radius: 10px;

            animation: skillLoad 1.4s ease;
        }

        .skill-card small {
            color: #64748b;
            font-size: 0.7rem;
        }

        /* =========================
           PROJECTS
        ========================= */
        .projects-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 22px;
        }

        .project-card {
            padding: 30px;

            background: #0d162b;

            border: 1px solid rgba(34, 211, 238, 0.13);

            border-radius: 16px;

            transition:
                transform 0.35s ease,
                border-color 0.35s ease,
                box-shadow 0.35s ease;
        }

        .project-card:hover {
            transform: translateY(-8px);

            border-color: rgba(34, 211, 238, 0.45);

            box-shadow:
                0 20px 45px rgba(0, 0, 0, 0.3),
                0 0 30px rgba(34, 211, 238, 0.06);
        }

        .project-tag {
            display: inline-block;

            padding: 5px 9px;

            margin-bottom: 22px;

            color: #22d3ee;

            background: rgba(34, 211, 238, 0.08);

            border: 1px solid rgba(34, 211, 238, 0.15);

            border-radius: 5px;

            font-size: 0.6rem;
            font-weight: 800;
        }

        .project-card h3 {
            font-size: 1.2rem;
            margin-bottom: 12px;
        }

        .project-card > p {
            color: #94a3b8;

            font-size: 0.86rem;

            margin-bottom: 20px;
        }

        .purpose {
            padding: 13px;

            margin-bottom: 20px;

            color: #cbd5e1;

            background: rgba(255, 255, 255, 0.025);

            border-left: 3px solid #8b5cf6;

            font-size: 0.78rem;
        }

        .purpose strong {
            color: #f8fafc;
        }

        .tech span {
            display: inline-block;

            padding: 5px 9px;

            margin-right: 5px;

            color: #a5b4fc;

            background: rgba(99, 102, 241, 0.08);

            border-radius: 5px;

            font-size: 0.65rem;
            font-weight: 600;
        }

        /* =========================
           CONTACT
        ========================= */
        .contact-section {
            background:
                radial-gradient(
                    circle at 80% 50%,
                    rgba(139, 92, 246, 0.08),
                    transparent 30%
                ),
                #080d1d !important;
        }

        .contact-grid {
            display: grid;

            grid-template-columns: 0.7fr 1.3fr;

            gap: 45px;

            align-items: start;
        }

        .contact-info {
            display: flex;

            flex-direction: column;

            gap: 15px;
        }

        .contact-card {
            display: flex;

            align-items: center;

            gap: 17px;

            padding: 20px;

            background: #0d162b;

            border: 1px solid rgba(34, 211, 238, 0.13);

            border-radius: 12px;

            transition: 0.3s ease;
        }

        .contact-card:hover {
            transform: translateX(5px);

            border-color: rgba(34, 211, 238, 0.4);
        }

        .contact-icon {
            width: 45px;
            height: 45px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            color: #22d3ee;

            background: rgba(34, 211, 238, 0.08);

            border-radius: 10px;

            font-weight: 800;
        }

        .contact-card small {
            display: block;

            color: #64748b;

            font-size: 0.7rem;

            margin-bottom: 3px;
        }

        .contact-card h3 {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .contact-form {
            padding: 30px;

            background: #0d162b;

            border: 1px solid rgba(34, 211, 238, 0.13);

            border-radius: 16px;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.25);
        }

        .form-row {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 15px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;

            color: #cbd5e1;

            font-size: 0.78rem;
            font-weight: 600;

            margin-bottom: 7px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;

            padding: 13px 14px;

            color: white;

            background: #080f20;

            border: 1px solid #1e293b;

            border-radius: 8px;

            outline: none;

            transition: 0.3s ease;
        }

        .form-group input::placeholder,
        .form-group textarea::placeholder {
            color: #52617b;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #22d3ee;

            box-shadow:
                0 0 0 3px rgba(34, 211, 238, 0.07);
        }

        textarea {
            resize: vertical;
        }

        /* =========================
           FOOTER
        ========================= */
        footer {
            padding: 28px 0;

            background: #050811;

            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        .footer-content {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;
        }

        footer p {
            color: #64748b;

            font-size: 0.75rem;
        }

        .back-top {
            color: #22d3ee;

            font-size: 0.75rem;
            font-weight: 700;

            transition: 0.3s;
        }

        .back-top:hover {
            color: #a78bfa;
        }

        /* =========================
           ANIMATIONS
        ========================= */
        @keyframes floating {
            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-12px);
            }
        }

        @keyframes skillLoad {
            from {
                width: 0;
            }
        }

        /* =========================
           TABLET
        ========================= */
        @media (max-width: 950px) {

            .nav-links {
                gap: 15px;
            }

            .nav-links a {
                font-size: 0.75rem;
            }

            .hero {
                grid-template-columns: 1fr;

                text-align: center;

                gap: 50px;
            }

            .hero-description {
                margin-left: auto;
                margin-right: auto;
            }

            .buttons {
                justify-content: center;
            }

            .profile-card {
                width: 100%;
                max-width: 430px;

                margin: auto;
            }

            .about-grid {
                grid-template-columns: 1fr 1fr;
            }

            .skills-grid {
                grid-template-columns: 1fr 1fr;
            }

            .projects-grid {
                grid-template-columns: 1fr 1fr;
            }

            .contact-grid {
                grid-template-columns: 1fr;
            }
        }

        /* =========================
           MOBILE
        ========================= */
        @media (max-width: 650px) {

            header {
                position: absolute;
            }

            nav {
                flex-direction: column;

                gap: 15px;

                padding: 16px 0;
            }

            .nav-links {
                width: 100%;

                justify-content: center;

                flex-wrap: wrap;

                gap: 11px;
            }

            .nav-links a {
                font-size: 0.65rem;
            }

            #home {
                padding: 155px 0 80px;
            }

            .hero h1 {
                font-size: 2.9rem;

                letter-spacing: -2px;
            }

            .hero h2 {
                font-size: 1rem;
            }

            .hero-description {
                font-size: 0.88rem;
            }

            .buttons {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            section:not(#home) {
                padding: 80px 0;
            }

            .section-heading {
                margin-bottom: 35px;
            }

            .section-heading h2 {
                font-size: 2.3rem;
            }

            .about-grid,
            .skills-grid,
            .projects-grid {
                grid-template-columns: 1fr;
            }

            .skill-card {
                min-height: auto;
            }

            .skill-card p {
                min-height: auto;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .contact-form {
                padding: 22px;
            }

            .footer-content {
                flex-direction: column;

                text-align: center;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         NAVIGATION
    ========================= -->
    <header>
        <nav class="container">

            <a href="#home" class="logo">
                <span>&lt;</span>Gelou<span>/&gt;</span>
